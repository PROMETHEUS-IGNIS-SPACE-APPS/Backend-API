# Copia este archivo como .env (no se sube al repositorio) y completa los valores.

# Clave de Google AI Studio para POST /api/ai/explain (botones "Interpretar con IA").
# Sin clave el endpoint responde 503 y el resto de la API funciona igual.
GEMINI_API_KEY=
# Modelo de Gemini (opcional).
GEMINI_MODEL=gemini-2.5-flash

# Orígenes permitidos por CORS, separados por comas (opcional).
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
